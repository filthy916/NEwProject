# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is listed in .gitignore.

# Required: your Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Required for backend endpoint protection (send via X-API-Key header)
BACKEND_API_KEY=your_backend_api_key_here

# Optional: default Groq model (default: llama3-8b-8192)
# GROQ_MODEL=llama3-8b-8192

# Optional: set to 1 to enable Flask debug mode (development only)
# FLASK_DEBUG=0
