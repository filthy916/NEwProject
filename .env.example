# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is listed in .gitignore.

# Required for Groq provider
GROQ_API_KEY=your_groq_api_key_here

# Optional for OpenAI provider
# OPENAI_API_KEY=your_openai_api_key_here

# Required for strict API entry gate (send via X-Auth-Secret header)
BRIDGE_SECRET_916=your_916_secret_here

# Optional: default provider models
# GROQ_MODEL=llama3-8b-8192
# OPENAI_MODEL=gpt-4o-mini

# Optional: translator resonance model for Groq
# GROQ_RESONANCE_MODEL=llama-3.3-70b-versatile

# Optional: set to 1 to enable Flask debug mode (development only)
# FLASK_DEBUG=0
